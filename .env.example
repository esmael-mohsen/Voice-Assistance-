# Runtime target: desktop, raspberry_pi
EGB_RUNTIME_TARGET=raspberry_pi

# External functions repository:
# https://github.com/rewanosama392-svg/EGB.git
EGB_FUNCTIONS_ROOT=/home/egb/Desktop/EGB
EGB_VOICE_ASSISTANT_DIR=/home/egb/Desktop/EGB/voice_assistant

# Optional: set to 1 when .env should override existing shell variables.
EGB_ENV_OVERRIDE=0

# GUI/session variables forwarded to external camera projects launched from SSH.
# Keep these empty on desktop if not needed.
EGB_EXTERNAL_DISPLAY=:0
EGB_EXTERNAL_XAUTHORITY=/run/user/1000/.mutter-Xwaylandauth.CHANGE_ME
EGB_EXTERNAL_WAYLAND_DISPLAY=wayland-0
EGB_EXTERNAL_TERMINAL_ENABLED=1
EGB_EXTERNAL_TERMINAL_APP=lxterminal
EGB_EXTERNAL_TERMINAL_HOLD_ON_EXIT=1

# Shared camera selection. Numeric values are propagated to OCR, Money, and Vision.
# Use EGB_CAMERA_SOURCE only for URL/file/OpenCV sources such as an IP camera stream.
EGB_CAMERA_INDEX=0
# EGB_CAMERA_SOURCE=

# Vision project
EGB_VISION_PROJECT_PATH="/home/egb/Desktop/EGB/Face emotin+ Face recognition"
EGB_VISION_PYTHON="/home/egb/Desktop/EGB/Face emotin+ Face recognition/.venv/bin/python"
EGB_VISION_CAMERA_INDEX=0
EGB_VISION_FRAME_WARMUP=3
EGB_VISION_CAPTURE_ATTEMPTS=2
EGB_VISION_CAPTURE_RETRY_MS=120
EGB_VISION_LOG_DIR=/home/egb/egb_logs/vision
EGB_VISION_COMMAND="bash -lc 'source .venv/bin/activate && exec python -u /home/egb/Desktop/EGB/voice_assistant/scripts/run_vision_with_camera_env.py'"

# OCR project
EGB_OCR_PROJECT_PATH=/home/egb/Desktop/EGB/blind_ocr_assistant-final
EGB_OCR_PYTHON=/home/egb/Desktop/EGB/blind_ocr_assistant-final/.venv/bin/python
EGB_OCR_LOG_DIR=/home/egb/egb_logs/ocr
EGB_OCR_COMMAND="bash -lc 'source .venv/bin/activate && exec python -u main.py'"
# Optional OCR runtime overrides passed into the external OCR project.
# ASSISTANT_MICROPHONE_INDEX=3
ASSISTANT_SHOW_WINDOW=true
ASSISTANT_VOICE_ENABLED=true

# Money detection project
EGB_MONEY_PROJECT_PATH=/home/egb/Desktop/EGB/Egyptian-Money-Detection--main
EGB_MONEY_PYTHON=/home/egb/Desktop/EGB/Egyptian-Money-Detection--main/.venv/bin/python
EGB_MONEY_LOG_DIR=/home/egb/egb_logs/money
EGB_MONEY_COMMAND="bash -lc 'source .venv/bin/activate && exec python -u main.py'"

# Walk / obstacle assistant project.
EGB_WALK_PROJECT_PATH=/home/egb/Desktop/EGB/Walk_Assistant
EGB_WALK_PYTHON=/home/egb/Desktop/EGB/Walk_Assistant/.venv/bin/python
EGB_WALK_LOG_DIR=/home/egb/egb_logs/walk
EGB_WALK_ENTRYPOINT=/home/egb/Desktop/EGB/Walk_Assistant/ros2_ws/src/blind_assist/launch/blind_assist.launch.py
EGB_WALK_COMMAND="bash -lc 'source /opt/ros/jazzy/setup.bash 2>/dev/null || source /opt/ros/humble/setup.bash 2>/dev/null || true; source ros2_ws/install/setup.bash 2>/dev/null || true; exec ros2 launch blind_assist blind_assist.launch.py'"

# Local STT fallback models
EGB_VOSK_MODEL_AR=/home/egb/models/vosk-ar
EGB_VOSK_MODEL_EN=/home/egb/models/vosk-en

# STT: use SpeechRecognition Google Web STT, the same no-JSON Google path used
# by the other EGB function projects. Keep official Google Cloud STT disabled
# unless a service-account JSON is intentionally configured later.
EGB_STT_ENGINE=google
EGB_STT_CLOUD_PRIMARY_ENABLED=0
EGB_STT_STRICT_VOSK_FALLBACK_ENABLED=0
EGB_STT_ENABLE_SPHINX_COMPAT=0
EGB_STT_CLOUD_TIMEOUT_S=3.0
EGB_STT_CLOUD_MAX_ALTERNATIVES=3

# TTS: keep the original neural edge-tts voice. mpg123 is only the MP3 player
# used on Raspberry Pi after edge-tts creates the audio file.
EGB_TTS_LOCAL_BACKEND=disabled
# EGB_TTS_ESPEAK_NG_PATH=/usr/bin/espeak-ng
EGB_TTS_PLAYBACK_BACKEND=mpg123
EGB_TTS_MPG123_PATH=/usr/bin/mpg123

# Official Google Cloud STT credentials are optional and should stay outside git.
# GOOGLE_APPLICATION_CREDENTIALS=/home/egb/secrets/google-stt.json
# EGB_TTS_AZURE_ENABLED=0
# EGB_TTS_AZURE_KEY=
# EGB_TTS_AZURE_REGION=
